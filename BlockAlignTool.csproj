<!--
  BlockAlignTool - plugin .NET para AutoCAD 2024 (.NET Framework 4.8).

  Las DLL de AutoCAD se buscan en $(AcadDir). Si tu instalacion o tu
  ObjectARX SDK estan en otra carpeta, crea junto a este archivo un
  BlockAlignTool.local.props (no se versiona) con tu ruta:

      <Project>
        <PropertyGroup>
          <AcadDir>D:\Ruta\AutoCAD 2024</AcadDir>
        </PropertyGroup>
      </Project>

  o compila con:
      dotnet build BlockAlignTool.csproj -c Release -p:AcadDir="D:\Ruta\AutoCAD 2024"
-->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ruta local de AutoCAD, opcional y fuera del control de versiones. -->
  <Import Project="BlockAlignTool.local.props" Condition="Exists('BlockAlignTool.local.props')" />

  <PropertyGroup>
    <!-- .NET Framework 4.8: requerido por AutoCAD 2021 a 2024 -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BlockAlignTool</AssemblyName>
    <RootNamespace>BlockAlignTool</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <Optimize>true</Optimize>
    <Version>1.0.0</Version>
    <Company>AGRDB - AGR Digital Building</Company>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AcadDir>
  </PropertyGroup>

  <!--
    Private = False  ->  NO copiar las DLL de AutoCAD al bin.
    Si se copian, AutoCAD carga dos veces los tipos y falla en runtime.
  -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
